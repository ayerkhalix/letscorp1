# No API key is required. The default provider is Leaflet + OpenStreetMap.
# Override the tile endpoint if you use a different licensed provider.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
# Optional: use the simulated map for an offline presentation.
NEXT_PUBLIC_MAP_MODE=live
